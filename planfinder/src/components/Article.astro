---
// Layout for guide pages: readable column, an ad slot after the intro, and links to other guides.
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import { href } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Short intro shown under the heading. */
  lede: string;
}
const { title, description, lede } = Astro.props;
const guides = [
  { href: href('savings/'), label: 'How much could you save?' },
  { href: href('discounts/'), label: 'Discounts you may qualify for' },
  { href: href('guides/how-much-data/'), label: 'How much data do you use?' },
  { href: href('guides/coverage/'), label: 'Check coverage where you live' },
  { href: href('guides/switching/'), label: 'Switching carriers checklist' },
  { href: href('guides/phone-deals/'), label: 'Phone deals vs. bringing your own' },
  { href: href('guides/glossary/'), label: 'Phone plan glossary' },
].filter((g) => g.href !== Astro.url.pathname);
---
<Base title={title} description={description} nav="guides">
  <div class="wrap layout">
    <article class="prose">
      <nav aria-label="Breadcrumb" class="crumbs small"><a href={href('guides/')}>Guides</a></nav>
      <h1 class="display">{title}</h1>
      <p class="lede">{lede}</p>
      <AdSlot name="guide-inline" />
      <slot />
    </article>
    <aside class="more" aria-label="More guides">
      <p class="eyebrow">More guides</p>
      <ul>{guides.map((g) => <li><a href={g.href}>{g.label}</a></li>)}</ul>
    </aside>
  </div>
</Base>

<style>
  .layout { padding-block: 24px 64px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
  .prose { flex: 999 1 560px; min-width: 0; max-width: 760px; display: flex; flex-direction: column; gap: 16px; font-size: 17px; line-height: 1.6; }
  .crumbs a { color: var(--muted); }
  h1 { font-size: clamp(34px, 5vw, 46px); }
  .lede { font-size: 19px; color: var(--muted); }
  .prose :global(h2) { font-family: var(--display); font-size: 26px; font-weight: 800; letter-spacing: -0.02em; margin-top: 16px; }
  .prose :global(h3) { font-size: 19px; margin-top: 8px; }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 6px; }
  .prose :global(.box) { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; }
  .prose :global(.warn) { background: #FDF3D7; border-color: #F0DFA6; }
  .more { flex: 1 1 240px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .more ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .more a { display: flex; align-items: center; min-height: 40px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .more a:hover { text-decoration: underline; }
</style>
