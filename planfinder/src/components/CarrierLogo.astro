---
import type { CarrierLite } from '../lib/model';
import { logoTile, type LogoMode } from '../lib/logo';

interface Props {
  carrier: CarrierLite;
  size?: number;
  mode?: LogoMode;
  /** Set when the carrier name is not written next to the logo. */
  labelled?: boolean;
}
const { carrier, size = 48, mode = 'brand', labelled = false } = Astro.props;
const t = logoTile(carrier, size, mode);
const alt = labelled ? `${carrier.name} logo` : '';
---
<span class={t.className} style={t.style}>
  {t.has ? <img src={carrier.logoUrl!} alt={alt} width={size} height={size} loading="lazy" /> : labelled ? <span role="img" aria-label={alt}>{carrier.monogram}</span> : <span aria-hidden="true">{carrier.monogram}</span>}
</span>
