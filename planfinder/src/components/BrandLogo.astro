---
// The SwitchWise logo: rising signal bars (the last one orange, with an arrow) and the wordmark.
import { BRAND, SITE_NAME } from '../lib/site';

interface Props {
  /** "light" for light backgrounds, "dark" for dark ones. */
  tone?: 'light' | 'dark';
  /** Icon size in px; the wordmark scales with it. */
  size?: number;
  /** Show the icon in its rounded tile (true) or bare bars only (false). */
  tile?: boolean;
  wordmark?: boolean;
}
const { tone = 'light', size = 36, tile = true, wordmark = true } = Astro.props;
const bar = BRAND.mint;
const lead = tone === 'dark' && !tile ? BRAND.accentOnDark : BRAND.accent;
const text = tone === 'dark' ? '#FFFFFF' : BRAND.ink;
---
<span class="brand-logo" style={`--size:${size}px;color:${text}`}>
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    {tile && <rect width="64" height="64" rx="16" fill={tone === 'dark' ? '#1E3A2E' : BRAND.ink}></rect>}
    <rect x="11" y="40" width="8" height="10" rx="2.5" fill={bar}></rect>
    <rect x="22" y="33" width="8" height="17" rx="2.5" fill={bar}></rect>
    <rect x="33" y="26" width="8" height="24" rx="2.5" fill={bar}></rect>
    <rect x="44" y="20" width="8" height="30" rx="2.5" fill={lead}></rect>
    <path d="M43 14.5 L48 9.5 L53 14.5" fill="none" stroke={lead} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {wordmark && <span class="word">{SITE_NAME}</span>}
</span>

<style>
  .brand-logo { display: inline-flex; align-items: center; gap: calc(var(--size) * 0.3); line-height: 1; }
  .brand-logo svg { flex: none; display: block; }
  .word { font-family: var(--body); font-weight: 800; letter-spacing: -0.05em; font-size: calc(var(--size) * 0.78); }
</style>
