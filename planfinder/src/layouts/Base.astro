---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import { getData } from '../lib/data';
import { href, SITE_NAME } from '../lib/site';
import { ADS, adsLive } from '../lib/ads';

interface Props {
  title: string;
  description: string;
  nav?: 'find' | 'plans' | 'carriers' | 'compare' | 'savings' | 'guides' | null;
  noindex?: boolean;
}
const { title, description, nav = null, noindex = false } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const { plans } = await getData();
// Every page carries the slim plan list so the shortlist and compare views work anywhere.
const index = JSON.stringify(plans.map((p) => p.lite)).replace(/</g, '\\u003c');
const links = [
  { id: 'find', label: 'Find a plan', href: href() },
  { id: 'plans', label: 'All plans', href: href('plans/') },
  { id: 'savings', label: 'Save money', href: href('savings/') },
  { id: 'guides', label: 'Guides', href: href('guides/') },
  { id: 'carriers', label: 'Carriers', href: href('carriers/') },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#F2F5F1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} price changes`} href={href('changes.xml')} />
    {adsLive() && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.adsenseClient}`} crossorigin="anonymous"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head wrap">
      <a class="brand display" href={href()}>{SITE_NAME.replace(/\.$/, '')}<span>.</span></a>
      <nav aria-label="Main">
        {links.map((l) => <a href={l.href} aria-current={nav === l.id ? 'page' : undefined}>{l.label}</a>)}
        <a class="btn btn-dark sl-link" href={href('compare/')} aria-current={nav === 'compare' ? 'page' : undefined}>
          Compare <span class="count" data-shortlist-count>0/4</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p class="display foot-brand">{SITE_NAME}</p>
        <p class="small">Prices are per line per month, with autopay where offered, before taxes and fees. Carriers change plans often: always confirm on the carrier's site before you switch. Plans marked “not yet verified” haven't been checked against the carrier's site.</p>
        <p class="small">Carrier names, colors and logos belong to their owners and are used only to identify their plans. {SITE_NAME} isn't affiliated with any carrier.</p>
        <nav aria-label="Footer" class="foot-links small">
          <a href={href('savings/')}>Savings calculator</a>
          <a href={href('discounts/')}>Discounts</a>
          <a href={href('guides/')}>Guides</a>
          <a href={href('vs/')}>Head-to-head</a>
          <a href={href('changes/')}>Price changes</a>
          <a href={href('changes.xml')}>RSS feed</a>
          <a href={href('about/')}>How we compare plans</a>
          <a href={href('privacy/')}>Privacy</a>
        </nav>
      </div>
    </footer>
    <script type="application/json" id="plan-index" set:html={index}></script>
    <script>
      import { initShortlist } from '../scripts/shortlist';
      initShortlist();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 16px; top: -60px; padding: 12px 16px; background: var(--ink); color: #FFFFFF; border-radius: 8px; z-index: 10; }
  .skip:focus { top: 12px; }
  .site-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding-block: 18px; }
  .brand { font-size: 26px; color: var(--ink); text-decoration: none; }
  .brand span { color: var(--accent); }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  nav a:not(.btn) { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; color: var(--ink); text-decoration: none; font-weight: 500; border-radius: 999px; }
  nav a:not(.btn):hover { background: var(--mint); color: var(--ink); }
  nav a[aria-current='page']:not(.btn) { font-weight: 700; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .sl-link { margin-left: 4px; min-height: 44px; padding: 0 16px; }
  .count { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 24px; padding: 0 6px; border-radius: 999px; background: #FFFFFF; color: var(--ink); font-size: 13px; }
  .site-foot { margin-top: 0; background: #0D1C16; color: #C9D8CF; }
  .foot-inner { padding-block: 40px; display: flex; flex-direction: column; gap: 12px; }
  .foot-inner p { max-width: 820px; }
  .site-foot a { color: #FFFFFF; }
  .foot-brand { color: #FFFFFF; font-size: 22px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .foot-links a { display: inline-flex; align-items: center; min-height: 36px; }
</style>
