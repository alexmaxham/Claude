---
import Base from '../../layouts/Base.astro';
import PlanCard from '../../components/PlanCard.astro';
import { getData } from '../../lib/data';
import { NETWORKS } from '../../lib/schema';
import AdSlot from '../../components/AdSlot.astro';

const { plans } = await getData();
const maxPrice = Math.ceil(Math.max(...plans.map((p) => p.price)) / 5) * 5;
const minPrice = Math.floor(Math.min(...plans.map((p) => p.price)) / 5) * 5;
const kinds = [
  { value: 'all', label: 'All' },
  { value: 'big3', label: 'Big 3' },
  { value: 'mvno', label: 'MVNO' },
  { value: 'prepaid', label: 'Prepaid' },
];
---
<Base title="All phone plans" description="Every phone plan we track from Verizon, AT&T, T-Mobile, MVNOs and prepaid carriers. Filter by network, carrier type and price." nav="plans">
  <div class="wrap page">
    <header class="head">
      <h1 class="display">All phone plans</h1>
      <p class="muted">Filter by carrier type, network and price, then shortlist up to four to compare.</p>
    </header>
    <div class="layout">
      <form id="filters" class="filters" aria-label="Filter plans">
        <fieldset>
          <legend>Carrier type</legend>
          <div class="seg">
            {kinds.map((k) => (
              <label><input type="radio" name="kind" value={k.value} checked={k.value === 'all'} /><span>{k.label}</span></label>
            ))}
          </div>
          <p class="small muted">MVNOs and prepaid brands rent space on one of the big three networks, usually for less.</p>
        </fieldset>
        <fieldset>
          <legend>Network</legend>
          {NETWORKS.map((n) => (
            <label class="check"><input type="checkbox" name="network" value={n} />{n}</label>
          ))}
          <p class="small muted">Leave all unticked to see every network.</p>
        </fieldset>
        <fieldset>
          <legend>Max price per line</legend>
          <label for="max" class="price-out"><output id="max-out" for="max">${maxPrice}</output><span class="small muted">/mo</span></label>
          <input id="max" name="max" type="range" min={minPrice} max={maxPrice} step="5" value={maxPrice} />
          <div class="range-ends small muted"><span>${minPrice}</span><span>${maxPrice}</span></div>
        </fieldset>
        <label class="sort">Sort by
          <select name="sort">
            <option value="price">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="hotspot">Hotspot: most first</option>
            <option value="carrier">Carrier: A to Z</option>
          </select>
        </label>
        <button type="reset" class="btn btn-ghost">Reset filters</button>
      </form>
      <section class="results" aria-label="Plans">
        <AdSlot name="plans-top" />
        <p id="count" class="count" aria-live="polite">{plans.length} plans</p>
        <p id="empty" class="empty" hidden>No plans match those filters. Try raising the max price or ticking another network.</p>
        <ul class="card-grid" id="plan-list">
          {plans.map((p) => <PlanCard plan={p} headingLevel="h2" />)}
        </ul>
      </section>
    </div>
  </div>
</Base>

<script>
  import { initBrowse } from '../../scripts/browse';
  initBrowse();
</script>

<style>
  .page { padding-block: 24px 64px; display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 8px; }
  h1 { font-size: clamp(36px, 5vw, 48px); }
  .layout { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; }
  .filters { flex: 1 1 260px; max-width: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  legend { padding: 0; margin-bottom: 10px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .seg { display: flex; flex-wrap: wrap; gap: 6px; }
  .seg label { position: relative; flex: 1 1 auto; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 2px solid var(--line); font-weight: 700; font-size: 14px; }
  .seg input:checked + span { background: var(--ink); border-color: var(--ink); color: #FFFFFF; }
  .seg input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .check { display: flex; align-items: center; gap: 10px; min-height: 36px; font-weight: 500; cursor: pointer; }
  .check input { width: 20px; height: 20px; accent-color: var(--forest); }
  .price-out { font-family: var(--display); font-size: 30px; font-weight: 800; }
  input[type='range'] { width: 100%; accent-color: var(--forest); }
  .range-ends { display: flex; justify-content: space-between; }
  .sort { display: flex; flex-direction: column; gap: 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .sort select { min-height: 44px; padding: 0 12px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); color: var(--ink); font-size: 15px; font-weight: 600; letter-spacing: 0; text-transform: none; }
  .results { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .count { font-weight: 700; }
  .empty { padding: 40px; text-align: center; border: 2px dashed var(--line); border-radius: var(--radius); color: var(--muted); }
</style>
