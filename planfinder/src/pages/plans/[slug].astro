---
import Base from '../../layouts/Base.astro';
import CarrierLogo from '../../components/CarrierLogo.astro';
import ShortlistButton from '../../components/ShortlistButton.astro';
import PlanCard from '../../components/PlanCard.astro';
import { getData, planTitle, type Plan } from '../../lib/data';
import { formatAmount, formatHotspot, formatNetworks, formatPerks, formatPrice, KIND_LONG, LINE_OPTIONS, priceFor } from '../../lib/model';
import { href } from '../../lib/site';
import AdSlot from '../../components/AdSlot.astro';
import { costOver, feeSummary } from '../../lib/cost';
import { changes, discounts } from '../../lib/extras';

export async function getStaticPaths() {
  const { plans } = await getData();
  return plans.map((plan) => ({ params: { slug: plan.slug }, props: { plan } }));
}
const { plan } = Astro.props as { plan: Plan };
const { plans } = await getData();
const c = plan.carrierInfo;
const title = planTitle(plan);
const discount = plan.lite.autopayDiscount;
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const sameCarrier = plans.filter((p) => p.carrier === plan.carrier && p.slug !== plan.slug);
const similar = plans
  .filter((p) => p.carrier !== plan.carrier)
  .sort((a, b) => Math.abs(a.price - plan.price) - Math.abs(b.price - plan.price))
  .slice(0, 3);

// Price for 1–4 lines, with and without AutoPay. The AutoPay discount is per line.
const pricing = LINE_OPTIONS.map((n) => {
  const lp = priceFor(plan.lite, n);
  const withoutPerLine = lp.perLine + discount;
  return {
    n,
    listed: lp.listed,
    perLine: lp.perLine,
    total: lp.total,
    withoutPerLine,
    withoutTotal: Math.abs(withoutPerLine * n - Math.round(withoutPerLine * n)) < 0.02 ? Math.round(withoutPerLine * n) : Math.round(withoutPerLine * n * 100) / 100,
  };
});
const anyUnlisted = pricing.some((r) => !r.listed);
const costs = LINE_OPTIONS.map((n) => ({ n, year: costOver(plan.lite, n, 12), two: costOver(plan.lite, n, 24) }));
const fees = c.fees;
const networkMaps: Record<string, string> = {
  Verizon: 'https://www.verizon.com/coverage-map/',
  'AT&T': 'https://www.att.com/maps/wireless-coverage.html',
  'T-Mobile': 'https://www.t-mobile.com/coverage/coverage-map',
};
const carrierDiscounts = discounts.filter((d) => d.carrier === plan.carrier);
const planChanges = changes.filter((ch) => ch.plans.includes(plan.slug));

const details: { heading: string; rows: [string, string][] }[] = [
  {
    heading: 'Data',
    rows: [
      ['Data', formatAmount(plan.data)],
      ['Premium data', formatAmount(plan.premiumData, 'None, so speeds may slow when the network is busy')],
      ['Hotspot', formatHotspot(plan)],
    ],
  },
  {
    heading: 'Network',
    rows: [
      ['Network', formatNetworks(plan.networks)],
      ['Carrier type', KIND_LONG[c.kind]],
    ],
  },
  {
    heading: 'Extras',
    rows: [
      ['Perks', formatPerks(plan.perks)],
      ['International', plan.international],
    ],
  },
  {
    heading: 'Billing',
    rows: [
      ['Billing', plan.billing === 'prepaid' ? 'Prepaid (pay before each month)' : 'Monthly bill (postpaid)'],
      ['Taxes & fees', plan.taxesIncluded ? 'Included in the price' : 'Extra, on top of the price'],
      ...(plan.terms ? ([['Terms', plan.terms]] as [string, string][]) : []),
    ],
  },
];

const verifiedText = plan.lastVerified
  ? `Checked against ${c.name}'s site on ${fmtDate(plan.lastVerified)}.`
  : `We haven't checked this plan against ${c.name}'s site yet, so the price and details may be out of date.`;
---
<Base title={`${title}: ${formatPrice(plan.price)}/mo`} description={plan.description} nav="plans">
  <div class="band" style={`background:${c.color};color:${c.textOnColor}`}>
    <div class="wrap band-inner">
      <nav aria-label="Breadcrumb" class="crumbs"><a href={href('plans/')}>All plans</a> / <a href={c.url}>{c.name}</a></nav>
      <div class="title-row">
        <CarrierLogo carrier={c.lite} size={64} mode="white" />
        <div>
          <p class="carrier-name">{c.name} · {KIND_LONG[c.kind]}</p>
          <h1 class="display">{plan.name}</h1>
        </div>
      </div>
      <p class="lede">{plan.description}</p>
    </div>
  </div>

  <div class="wrap page">
    <section class="summary" aria-label="Price summary">
      <div class="price-box">
        <p class="price-line"><span class="display big">{formatPrice(plan.price)}</span> <span class="muted">per line per month</span></p>
        <p class="price-note">
          {discount > 0
            ? <>With AutoPay. {formatPrice(plan.price + discount)} without it.</>
            : <>No AutoPay discount: the same price however you pay.</>}
          {' '}{plan.taxesIncluded ? 'Taxes and fees included.' : 'Plus taxes and fees.'}
        </p>
        {plan.highlights.length > 0 && <ul class="highlights">{plan.highlights.map((h) => <li>{h}</li>)}</ul>}
        <div class="actions">
          <ShortlistButton slug={plan.slug} name={title} />
          <a class="btn btn-ghost" href={plan.sourceUrl} rel="noopener" target="_blank">See it on {c.name}<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <p class:list={['verify', !plan.lastVerified && 'unverified']}>{verifiedText}</p>
      </div>
      <nav class="toc" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <a href="#pricing">Pricing</a>
        <a href="#cost">Real cost</a>
        <a href="#autopay">AutoPay discount</a>
        <a href="#coverage">Coverage</a>
        <a href="#details">Plan details</a>
        <a href="#deals">Deals{plan.deals.length > 0 && ` (${plan.deals.length})`}</a>
        <div class="side-ad"><AdSlot name="plan-sidebar" format="rectangle" /></div>
      </nav>
    </section>

    <section id="pricing" class="sec" aria-labelledby="pricing-h">
      <h2 id="pricing-h" class="display">Pricing</h2>
      <div class="table-box">
        <table>
          <caption class="sr-only">{title} monthly price by number of lines</caption>
          <thead>
            <tr>
              <th scope="col">Lines</th>
              <th scope="col">Per line{discount > 0 && ' with AutoPay'}</th>
              <th scope="col">Total{discount > 0 && ' with AutoPay'}</th>
              {discount > 0 && <th scope="col">Per line without AutoPay</th>}
              {discount > 0 && <th scope="col">Total without AutoPay</th>}
            </tr>
          </thead>
          <tbody>
            {pricing.map((r) => (
              <tr>
                <th scope="row">{r.n} {r.n === 1 ? 'line' : 'lines'}</th>
                <td>{formatPrice(r.perLine)}{!r.listed && <span aria-hidden="true">*</span>}</td>
                <td><strong>{formatPrice(r.total)}</strong>/mo</td>
                {discount > 0 && <td>{formatPrice(r.withoutPerLine)}</td>}
                {discount > 0 && <td>{formatPrice(r.withoutTotal)}/mo</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="notes small muted">
        {anyUnlisted && <li>* {c.name} doesn't list a price for this many lines, so this uses the 1-line price. Ask {c.name} about multi-line discounts.</li>}
        <li>{plan.taxesIncluded ? 'Taxes and fees are included in these prices.' : 'Taxes and fees are extra.'}{plan.terms && ` ${plan.terms}`}</li>
        <li>Prices are regular prices. Limited-time deals are listed separately below and aren't included.</li>
      </ul>
    </section>

    <section id="cost" class="sec" aria-labelledby="cost-h">
      <h2 id="cost-h" class="display">Real cost</h2>
      <p class="muted">What you'd actually pay, including fees the monthly price leaves out.</p>
      <div class="table-box">
        <table>
          <caption class="sr-only">{title} cost over one and two years</caption>
          <thead><tr><th scope="col">Lines</th><th scope="col">First year</th><th scope="col">Average per month</th><th scope="col">Two years</th></tr></thead>
          <tbody>
            {costs.map((r) => (
              <tr>
                <th scope="row">{r.n} {r.n === 1 ? 'line' : 'lines'}</th>
                <td><strong>{formatPrice(r.year.total)}</strong></td>
                <td>{formatPrice(r.year.perMonth)}</td>
                <td>{formatPrice(r.two.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="notes small muted">
        <li>{feeSummary(plan.lite)}</li>
        {fees.monthlyNote && <li>{fees.monthlyNote}</li>}
        <li>One-time fees: {fees.oneTimeNote}{fees.oneTimePerLine === null && ' If there is one, add it to the first year.'}</li>
        <li>{plan.taxesIncluded ? 'Taxes and fees are included.' : 'Taxes and government fees are extra and depend on where you live.'}</li>
      </ul>
    </section>

    <section id="autopay" class="sec" aria-labelledby="autopay-h">
      <h2 id="autopay-h" class="display">AutoPay discount</h2>
      <div class="autopay">
        <p class="ap-amount">
          {discount > 0
            ? <><span class="display">{formatPrice(discount)}</span> off per line, per month</>
            : <span class="display">No discount</span>}
        </p>
        <p>{plan.autopayTerms}</p>
        {discount > 0 && <p class="muted small">Our prices include this discount. If you don't use AutoPay, or pay in a way that doesn't qualify, you pay {formatPrice(plan.price + discount)} per line instead of {formatPrice(plan.price)}.</p>}
      </div>
    </section>

    <section id="coverage" class="sec" aria-labelledby="coverage-h">
      <h2 id="coverage-h" class="display">Coverage</h2>
      <div class="autopay">
        <p>This plan runs on the <strong>{formatNetworks(plan.networks)}</strong> network{plan.networks.length > 1 && 's (you choose when you sign up)'}. Check the map for your home and work before you switch.</p>
        <p class="map-links">
          {c.coverageUrl && <a class="btn btn-ghost" href={c.coverageUrl} rel="noopener" target="_blank">{c.name} coverage map<span class="sr-only"> (opens in a new tab)</span></a>}
          {plan.networks.filter((n) => networkMaps[n] && networkMaps[n] !== c.coverageUrl).map((n) => <a class="btn btn-ghost" href={networkMaps[n]} rel="noopener" target="_blank">{n} network map<span class="sr-only"> (opens in a new tab)</span></a>)}
        </p>
        <p class="small muted"><a href={href('guides/coverage/')}>Tips for checking coverage</a></p>
      </div>
    </section>

    <section id="details" class="sec" aria-labelledby="details-h">
      <h2 id="details-h" class="display">Plan details</h2>
      <div class="detail-grid">
        {details.map((g) => (
          <div class="detail-card">
            <h3>{g.heading}</h3>
            <dl>
              {g.rows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section id="deals" class="sec" aria-labelledby="deals-h">
      <h2 id="deals-h" class="display">Deals</h2>
      {plan.deals.length > 0 ? (
        <ul class="deals">
          {plan.deals.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <p>{d.details}</p>
              {d.ends && <p class="small muted">Ends {fmtDate(d.ends)}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">No limited-time deals listed for this plan right now.</p>
      )}
      {carrierDiscounts.length > 0 && (
        <div class="discounts">
          <h3>Discounts {c.name} offers</h3>
          <ul>{carrierDiscounts.map((d) => <li><strong>{d.title}.</strong> {d.details}</li>)}</ul>
          <p class="small"><a href={href('discounts/')}>All discounts</a></p>
        </div>
      )}
      <p class="small muted">Deals change often and come with conditions. They aren't included in the prices above.{plan.lastVerified && ` Last checked ${fmtDate(plan.lastVerified)}.`} Confirm with {c.name} before you sign up.</p>
    </section>

    {planChanges.length > 0 && (
      <section class="sec" aria-labelledby="changes-h">
        <h2 id="changes-h" class="display">Recent changes</h2>
        <ul class="notes">{planChanges.map((ch) => <li><strong>{fmtDate(ch.date)}: {ch.title}.</strong> {ch.details}</li>)}</ul>
        <p class="small"><a href={href('changes/')}>All price changes</a></p>
      </section>
    )}

    <AdSlot name="plan-bottom" />

    {sameCarrier.length > 0 && (
      <section class="sec" aria-labelledby="same-h">
        <h2 id="same-h" class="display">Other {c.name} plans</h2>
        <ul class="card-grid">{sameCarrier.map((p) => <PlanCard plan={p} />)}</ul>
      </section>
    )}
    <section class="sec" aria-labelledby="sim-h">
      <h2 id="sim-h" class="display">Similar price, other carriers</h2>
      <ul class="card-grid">{similar.map((p) => <PlanCard plan={p} />)}</ul>
    </section>
  </div>
</Base>

<style>
  .band-inner { padding-block: 24px 32px; display: flex; flex-direction: column; gap: 16px; }
  .crumbs { font-size: 14px; }
  .crumbs a { color: inherit; }
  .title-row { display: flex; align-items: center; gap: 16px; }
  .carrier-name { font-weight: 700; }
  h1 { font-size: clamp(34px, 5vw, 50px); }
  .lede { max-width: 760px; font-size: 18px; line-height: 1.5; }
  .page { padding-block: 32px 64px; display: flex; flex-direction: column; gap: 48px; }
  .summary { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .price-box { flex: 999 1 420px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .big { font-size: 48px; }
  .price-note { color: var(--muted); }
  .highlights { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; font-weight: 500; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .actions > * { flex: 1 1 200px; }
  .verify { font-size: 14px; color: var(--muted); }
  .verify.unverified { padding: 10px 12px; border-radius: 12px; background: #FDF3D7; color: #6B4A00; }
  .toc { flex: 1 1 200px; display: flex; flex-direction: column; gap: 2px; padding: 20px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .toc .eyebrow { margin-bottom: 6px; }
  .toc a { display: flex; align-items: center; min-height: 40px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  .sec { display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 16px; }
  .sec h2 { font-size: 28px; }
  .table-box { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 16px; }
  th, td { padding: 14px 18px; text-align: left; border-top: 1px solid var(--line-soft); }
  thead th { border-top: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); background: var(--ground); }
  tbody th { font-weight: 700; }
  .notes { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; }
  .autopay { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 10px; max-width: 820px; }
  .ap-amount .display { font-size: 32px; margin-right: 6px; }
  .detail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .detail-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .detail-card h3 { font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); padding: 16px 20px 8px; }
  .detail-card dl { margin: 0; }
  .detail-card dl div { padding: 12px 20px; border-top: 1px solid var(--line-soft); }
  .detail-card dt { font-size: 14px; color: var(--muted); }
  .detail-card dd { margin: 2px 0 0; font-weight: 700; }
  .deals { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .deals li { background: var(--surface); border: 1px solid var(--line); border-left-width: 1px; border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .deals h3 { font-size: 18px; }
  .side-ad { margin-top: 16px; }
  .map-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .discounts { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .discounts h3 { font-size: 18px; }
  .discounts ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
</style>
