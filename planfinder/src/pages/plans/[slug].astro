---
import Base from '../../layouts/Base.astro';
import CarrierLogo from '../../components/CarrierLogo.astro';
import ShortlistButton from '../../components/ShortlistButton.astro';
import PlanCard from '../../components/PlanCard.astro';
import { getData, planTitle, type Plan } from '../../lib/data';
import { formatAmount, formatHotspot, formatNetworks, formatPerks, formatPrice, KIND_LONG } from '../../lib/model';
import { href } from '../../lib/site';

export async function getStaticPaths() {
  const { plans } = await getData();
  return plans.map((plan) => ({ params: { slug: plan.slug }, props: { plan } }));
}
const { plan } = Astro.props as { plan: Plan };
const { plans } = await getData();
const c = plan.carrierInfo;
const title = planTitle(plan);
const sameCarrier = plans.filter((p) => p.carrier === plan.carrier && p.slug !== plan.slug);
const similar = plans
  .filter((p) => p.carrier !== plan.carrier)
  .sort((a, b) => Math.abs(a.price - plan.price) - Math.abs(b.price - plan.price))
  .slice(0, 3);
const specs: [string, string][] = [
  ['Price per line', `${formatPrice(plan.price)}/mo${plan.priceWithoutAutopay ? ` with autopay (${formatPrice(plan.priceWithoutAutopay)} without)` : ''}`],
  ['Network', formatNetworks(plan.networks)],
  ['Carrier type', KIND_LONG[c.kind]],
  ['Data', formatAmount(plan.data)],
  ['Premium data', formatAmount(plan.premiumData, 'None (may slow when the network is busy)')],
  ['Hotspot', formatHotspot(plan)],
  ['Perks', formatPerks(plan.perks)],
  ['International', plan.international],
  ['Billing', plan.billing === 'prepaid' ? 'Prepaid' : 'Monthly bill (postpaid)'],
];
if (plan.terms) specs.push(['Terms', plan.terms]);
if (plan.multiLine) {
  for (const [n, price] of Object.entries(plan.multiLine)) if (price) specs.push([`With ${n} lines`, `${formatPrice(price)}/mo per line`]);
}
const verifiedText = plan.lastVerified
  ? `Checked against ${c.name}'s site on ${new Date(plan.lastVerified + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}.`
  : `We haven't checked this plan against ${c.name}'s site yet, so the price and details may be out of date.`;
---
<Base title={`${title}: ${formatPrice(plan.price)}/mo`} description={`${title} costs ${formatPrice(plan.price)} per line per month on the ${formatNetworks(plan.networks)} network, with ${formatAmount(plan.premiumData).toLowerCase()} premium data and ${formatHotspot(plan).toLowerCase()} hotspot.`} nav="plans">
  <div class="band" style={`background:${c.color};color:${c.textOnColor}`}>
    <div class="wrap band-inner">
      <nav aria-label="Breadcrumb" class="crumbs"><a href={href('plans/')}>All plans</a> / <a href={c.url}>{c.name}</a></nav>
      <div class="title-row">
        <CarrierLogo carrier={c.lite} size={64} mode="white" />
        <div>
          <p class="carrier-name">{c.name}</p>
          <h1 class="display">{plan.name}</h1>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap page">
    <section class="main">
      <div class="price-box">
        <p><span class="display big">{formatPrice(plan.price)}</span> <span class="muted">per line per month</span></p>
        {plan.highlights.length > 0 && <ul class="highlights">{plan.highlights.map((h) => <li>{h}</li>)}</ul>}
        <div class="actions">
          <ShortlistButton slug={plan.slug} name={title} />
          <a class="btn btn-ghost" href={plan.sourceUrl} rel="noopener" target="_blank">See it on {c.name}<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <p class:list={['verify', !plan.lastVerified && 'unverified']}>{verifiedText}</p>
      </div>
      <dl class="specs">
        {specs.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    </section>
    {sameCarrier.length > 0 && (
      <section class="more" aria-labelledby="same-h">
        <h2 id="same-h" class="display">Other {c.name} plans</h2>
        <ul class="card-grid">{sameCarrier.map((p) => <PlanCard plan={p} />)}</ul>
      </section>
    )}
    <section class="more" aria-labelledby="sim-h">
      <h2 id="sim-h" class="display">Similar price, other carriers</h2>
      <ul class="card-grid">{similar.map((p) => <PlanCard plan={p} />)}</ul>
    </section>
  </div>
</Base>

<style>
  .band-inner { padding-block: 24px 32px; display: flex; flex-direction: column; gap: 20px; }
  .crumbs { font-size: 14px; }
  .crumbs a { color: inherit; }
  .title-row { display: flex; align-items: center; gap: 16px; }
  .carrier-name { font-weight: 700; }
  h1 { font-size: clamp(34px, 5vw, 50px); }
  .page { padding-block: 32px 64px; display: flex; flex-direction: column; gap: 48px; }
  .main { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .price-box { flex: 1 1 340px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .big { font-size: 48px; }
  .highlights { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; font-weight: 500; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .actions > * { flex: 1 1 200px; }
  .verify { font-size: 14px; color: var(--muted); }
  .verify.unverified { padding: 10px 12px; border-radius: 12px; background: #FDF3D7; color: #6B4A00; }
  .specs { flex: 2 1 480px; margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .specs div { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: 16px; padding: 14px 20px; border-top: 1px solid var(--line-soft); }
  .specs div:first-child { border-top: 0; }
  .specs dt { color: var(--muted); font-weight: 500; }
  .specs dd { margin: 0; font-weight: 700; }
  .more { display: flex; flex-direction: column; gap: 16px; }
  .more h2 { font-size: 28px; }
</style>
