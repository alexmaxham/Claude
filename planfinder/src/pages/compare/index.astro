---
import Base from '../../layouts/Base.astro';
import { getData, planTitle } from '../../lib/data';
import { formatPrice } from '../../lib/model';
import { href } from '../../lib/site';

const { plans, carriers } = await getData();
---
<Base title="Compare plans" description="Compare up to four phone plans side by side: price, network, premium data, hotspot, perks and more." nav="compare" noindex>
  <div class="wrap page">
    <div class="head">
      <div>
        <h1 class="display">Compare plans</h1>
        <p id="status" class="muted" aria-live="polite">Loading your shortlist…</p>
      </div>
      <div class="tools">
        <label class="check"><input type="checkbox" id="diff-only" />Only show differences</label>
        <button type="button" class="btn btn-ghost" id="copy-link">Copy link to this comparison</button>
      </div>
    </div>

    <div id="shared" class="shared" hidden>
      <p><strong>You opened a shared comparison.</strong> It isn't saved to your shortlist yet.</p>
      <div class="shared-actions">
        <button type="button" class="btn btn-dark" id="save-shared">Use these as my shortlist</button>
        <a class="btn btn-ghost" href={href('compare/')}>Show my own shortlist</a>
      </div>
    </div>

    <div id="empty" class="empty" hidden>
      <h2 class="display">Nothing to compare yet</h2>
      <p class="muted">Add up to four plans to your shortlist, then come back here.</p>
      <div class="shared-actions">
        <a class="btn btn-primary" href={href()}>Find a plan</a>
        <a class="btn btn-ghost" href={href('plans/')}>Browse all plans</a>
      </div>
    </div>

    <div class="cmp" id="compare"></div>

    <form id="add-form" class="add" hidden>
      <label for="add-plan">Add a plan</label>
      <select id="add-plan">
        <option value="">Choose a plan…</option>
        {carriers.map((c) => (
          <optgroup label={c.name}>
            {plans.filter((p) => p.carrier === c.slug).map((p) => <option value={p.slug}>{planTitle(p)} · {formatPrice(p.price)}/mo</option>)}
          </optgroup>
        ))}
      </select>
      <button type="submit" class="btn btn-primary">Add</button>
    </form>
    <noscript><p>The comparison needs JavaScript turned on.</p></noscript>
  </div>
</Base>

<script>
  import { initCompare } from '../../scripts/compare';
  initCompare();
</script>

<style>
  .page { padding-block: 24px 64px; display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  h1 { font-size: clamp(36px, 5vw, 48px); margin-bottom: 6px; }
  .tools { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .check { display: flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 500; cursor: pointer; }
  .check input { width: 20px; height: 20px; accent-color: var(--forest); }
  .shared { padding: 16px 20px; border-radius: var(--radius); background: var(--mint); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .shared-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .empty { padding: 48px 24px; border: 2px dashed var(--line); border-radius: var(--radius); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .empty h2 { font-size: 28px; }
  .add { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 16px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .add label { font-weight: 700; }
  .add select { flex: 1 1 260px; min-height: 48px; padding: 0 12px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); font-size: 15px; }
</style>
