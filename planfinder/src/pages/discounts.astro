---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import CarrierLogo from '../components/CarrierLogo.astro';
import { getData } from '../lib/data';
import { discounts, GROUP_LABEL } from '../lib/extras';
import { DISCOUNT_GROUPS } from '../lib/schema';

const { carriers } = await getData();
const bySlug = new Map(carriers.map((c) => [c.slug, c]));
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Phone plan discounts you may qualify for" description="Discounts for military, first responders, nurses, teachers, students, 55+, employer programs and low-income households, from each carrier's own site." nav="savings">
  <div class="wrap page">
    <header class="head">
      <h1 class="display">Discounts you may qualify for</h1>
      <p class="lede">Many carriers take money off for certain jobs, ages or incomes. Pick what applies to you. These discounts aren't included in our plan prices, so they're extra savings on top.</p>
    </header>
    <fieldset class="chips">
      <legend class="sr-only">Show discounts for</legend>
      <label><input type="radio" name="group" value="all" checked /><span>All</span></label>
      {DISCOUNT_GROUPS.map((g) => <label><input type="radio" name="group" value={g} /><span>{GROUP_LABEL[g]}</span></label>)}
    </fieldset>
    <ul class="grid" id="discount-list">
      {discounts.map((d) => {
        const c = d.carrier ? bySlug.get(d.carrier) : null;
        return (
          <li data-groups={d.groups.join(' ')} style={`--brand:${c ? c.color : 'var(--forest)'}`}>
            <div class="who">
              {c ? <CarrierLogo carrier={c.lite} size={40} /> : null}
              <span class="small muted">{c ? c.name : 'All carriers'}</span>
            </div>
            <h2>{d.title}</h2>
            <p>{d.details}</p>
            <p class="tags">{d.groups.map((g) => <span class="pill">{GROUP_LABEL[g]}</span>)}</p>
            <p class="small muted">Checked {fmt(d.checked)} · <a href={d.sourceUrl} rel="noopener" target="_blank">Details on {c ? c.name : 'the program'}'s site<span class="sr-only"> (opens in a new tab)</span></a></p>
          </li>
        );
      })}
    </ul>
    <p id="none" class="muted" hidden>No discounts listed for this group yet.</p>
    <div class="box">
      <h2>Before you sign up</h2>
      <ul>
        <li>You'll almost always need to prove you qualify, with an ID, a pay stub, a school email or similar.</li>
        <li>Discounts usually only apply to certain plans, and often can't be combined with each other.</li>
        <li>Amounts and rules change. Check the carrier's page for the current terms.</li>
      </ul>
    </div>
    <AdSlot name="discounts-bottom" />
  </div>
</Base>

<script>
  const list = document.getElementById('discount-list')!;
  const none = document.getElementById('none')!;
  function apply() {
    const g = (document.querySelector('input[name="group"]:checked') as HTMLInputElement).value;
    let shown = 0;
    list.querySelectorAll<HTMLElement>('li').forEach((li) => {
      const ok = g === 'all' || li.dataset.groups!.split(' ').includes(g);
      li.hidden = !ok;
      if (ok) shown++;
    });
    none.hidden = shown > 0;
    const url = new URL(location.href);
    if (g === 'all') url.searchParams.delete('for'); else url.searchParams.set('for', g);
    history.replaceState(null, '', url);
  }
  const initial = new URLSearchParams(location.search).get('for');
  const input = initial && document.querySelector<HTMLInputElement>(`input[name="group"][value="${CSS.escape(initial)}"]`);
  if (input) input.checked = true;
  document.querySelectorAll('input[name="group"]').forEach((el) => el.addEventListener('change', apply));
  apply();
</script>

<style>
  .page { padding-block: 24px 64px; display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
  h1 { font-size: clamp(34px, 5vw, 48px); }
  .lede { font-size: 18px; color: var(--muted); }
  .chips { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips label { position: relative; }
  .chips input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chips span { display: flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 2px solid var(--line); background: var(--surface); font-weight: 700; font-size: 14px; }
  .chips input:checked + span { background: var(--ink); border-color: var(--ink); color: #FFFFFF; }
  .chips input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .grid li { background: var(--surface); border: 1px solid var(--line); border-top: 6px solid var(--brand); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .who { display: flex; align-items: center; gap: 10px; }
  .grid h2 { font-size: 20px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; max-width: 820px; }
  .box h2 { font-size: 20px; }
  .box ul { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 6px; }
</style>
