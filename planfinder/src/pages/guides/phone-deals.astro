---
import Article from '../../components/Article.astro';
import { href } from '../../lib/site';
---
<Article title="Phone deals vs. bringing your own" description="Work out what a 'free' phone deal really costs: monthly bill credits, required plans and what happens if you leave early." lede="A $0 or $800-off phone sounds like free money. Usually it's paid back through a pricier plan you have to keep for years.">
  <h2>How most phone deals work</h2>
  <ul>
    <li><strong>The discount is spread out as monthly bill credits</strong>, often over 24 or 36 months. You pay the phone's full price in monthly installments, and the credit cancels it out each month.</li>
    <li><strong>Leave early, and the credits stop.</strong> You owe the rest of the phone's price.</li>
    <li><strong>The best deals usually require the carrier's most expensive plans.</strong> The extra you pay each month can add up to more than the phone discount.</li>
  </ul>
  <h2>Work out the real cost</h2>
  <form id="deal-calc" class="box calc">
    <div class="row">
      <label for="phone-price">Phone's full price</label>
      <div class="money"><span aria-hidden="true">$</span><input id="phone-price" type="number" min="0" step="1" value="1000" /></div>
    </div>
    <div class="row">
      <label for="credit">Deal discount (total bill credits)</label>
      <div class="money"><span aria-hidden="true">$</span><input id="credit" type="number" min="0" step="1" value="800" /></div>
    </div>
    <div class="row">
      <label for="months">Months the credits are spread over</label>
      <input id="months" type="number" min="1" step="1" value="36" />
    </div>
    <div class="row">
      <label for="plan-deal">Plan price the deal requires, per month</label>
      <div class="money"><span aria-hidden="true">$</span><input id="plan-deal" type="number" min="0" step="1" value="100" /></div>
    </div>
    <div class="row">
      <label for="plan-byo">Plan you'd pick otherwise, per month</label>
      <div class="money"><span aria-hidden="true">$</span><input id="plan-byo" type="number" min="0" step="1" value="45" /></div>
    </div>
    <output id="deal-out" for="phone-price credit months plan-deal plan-byo" aria-live="polite"></output>
  </form>
  <p class="small muted">The calculation compares the total over the deal's length: the phone's price minus credits, plus the required plan, against buying the phone yourself and choosing the plan you'd pick anyway.</p>
  <h2>Ways to get a phone for less</h2>
  <ul>
    <li><strong>Keep your current phone</strong> and switch to a cheaper plan. Most phones work for years.</li>
    <li><strong>Buy unlocked</strong> from the phone maker or a store, often with 0% financing that isn't tied to a carrier.</li>
    <li><strong>Buy last year's model or certified refurbished</strong>, often hundreds of dollars cheaper.</li>
  </ul>
  <p><a class="btn btn-primary" href={href('savings/')}>See how much a cheaper plan saves</a></p>
</Article>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const out = document.getElementById('deal-out')!;
  const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
  function calc() {
    const price = Number($('phone-price').value) || 0;
    const credit = Math.min(Number($('credit').value) || 0, price);
    const months = Math.max(1, Number($('months').value) || 1);
    const planDeal = Number($('plan-deal').value) || 0;
    const planByo = Number($('plan-byo').value) || 0;
    const deal = price - credit + planDeal * months;
    const byo = price + planByo * months;
    const diff = deal - byo;
    out.innerHTML =
      `<p>Over ${months} months: <strong>${money(deal)}</strong> with the deal vs <strong>${money(byo)}</strong> buying the phone yourself.</p>` +
      (diff > 0
        ? `<p class="verdict bad">The deal costs <strong>${money(diff)} more</strong>, even with ${money(credit)} off the phone.</p>`
        : diff < 0
          ? `<p class="verdict good">The deal saves <strong>${money(-diff)}</strong>, as long as you keep the plan for all ${months} months.</p>`
          : `<p class="verdict">It's about the same either way.</p>`);
  }
  document.getElementById('deal-calc')!.addEventListener('input', calc);
  calc();
</script>
<style>
  .calc { display: grid !important; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 16px 24px !important; }
  .row { display: flex; flex-direction: column; gap: 6px; }
  .row label { font-weight: 700; font-size: 15px; }
  .money { display: flex; align-items: center; gap: 6px; border: 2px solid var(--line); border-radius: 12px; padding: 0 12px; background: var(--surface); }
  .money:focus-within, .row > input:focus { border-color: var(--forest); }
  .money input, .row > input { border: 0; outline: none; min-height: 44px; width: 100%; font-size: 18px; font-weight: 700; background: transparent; }
  .row > input { border: 2px solid var(--line); border-radius: 12px; padding: 0 12px; }
  output { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 6px; padding-top: 6px; border-top: 1px solid var(--line-soft); }
  output :global(.verdict) { font-size: 18px; }
  output :global(.bad strong) { color: var(--accent); }
  output :global(.good strong) { color: #146C43; }
</style>
