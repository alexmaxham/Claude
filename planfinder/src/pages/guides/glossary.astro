---
import Article from '../../components/Article.astro';
const terms: [string, string][] = [
  ['AutoPay discount', 'Money off each month for paying automatically. Some carriers only give it for a bank account or their own credit card, not a regular credit or debit card.'],
  ['Bill credits', 'How most phone deals are paid: a small credit on each bill over 24–36 months. If you leave early, the credits stop and you owe the rest of the phone.'],
  ['Deprioritization', 'When a tower is busy, the carrier slows some users first. Data after your premium allowance, and data on many MVNO and prepaid plans, is usually slowed first.'],
  ['eSIM', 'A digital SIM built into your phone. It lets you switch carriers online in minutes, with no card in the mail.'],
  ['Hotspot', 'Sharing your phone\'s data with a laptop or tablet. Plans give a set amount at full speed, and some allow unlimited at a slower speed.'],
  ['IMEI', 'Your phone\'s unique ID number. Carriers use it to check your phone works on their network. Dial *#06# to see it.'],
  ['Locked / unlocked phone', 'A locked phone only works with the carrier that sold it. Carriers unlock phones once they\'re paid off and the account has been active for a while.'],
  ['Major carrier (big 3)', 'Verizon, AT&T and T-Mobile, which own the national networks.'],
  ['MVNO', 'Mobile virtual network operator: a company like Mint, Visible or Google Fi that rents space on a big 3 network and resells it, often for less.'],
  ['Number transfer PIN', 'A code from your current carrier that lets a new carrier move your phone number. Also called a port-out PIN.'],
  ['Porting', 'Moving your phone number from one carrier to another.'],
  ['Postpaid', 'You use service first and get a bill after. Usually needs a credit check.'],
  ['Premium data', 'Data that isn\'t slowed when the network is busy. After you use it up, you still have data, but it may slow down at busy times.'],
  ['Prepaid', 'You pay before each month. No credit check, and usually taxes are included in the price.'],
  ['Taxes and fees', 'Charges on top of the plan price. They vary by state and city. Some carriers also add their own per-line fees.'],
];
---
<Article title="Phone plan glossary" description="Phone plan terms in plain words: premium data, deprioritization, MVNO, eSIM, porting, bill credits and more." lede="The words carriers use, explained without the jargon.">
  <dl class="terms">
    {terms.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
  </dl>
</Article>
<style>
  .terms { margin: 0; display: flex; flex-direction: column; gap: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .terms div { padding: 16px 20px; border-top: 1px solid var(--line-soft); }
  .terms div:first-child { border-top: 0; }
  .terms dt { font-weight: 700; font-size: 18px; }
  .terms dd { margin: 4px 0 0; color: var(--muted); }
</style>
