---
import Base from '../../layouts/Base.astro';
import { getData, planTitle } from '../../lib/data';
import { versusPairs } from '../../lib/extras';
import { href } from '../../lib/site';
import { formatPrice } from '../../lib/model';
const { plans } = await getData();
const by = new Map(plans.map((p) => [p.slug, p]));
const items = versusPairs.map(([x, y]) => ({ a: by.get(x)!, b: by.get(y)!, url: href(`vs/${x}-vs-${y}/`) }));
---
<Base title="Head-to-head plan comparisons" description="Popular phone plans compared side by side: Mint vs Visible, Verizon vs T-Mobile and more." nav="plans">
  <div class="wrap page">
    <h1 class="display">Head-to-head</h1>
    <p class="lede">Popular plans compared side by side. To compare any plans you like, use the <a href={href('compare/')}>comparison tool</a>.</p>
    <ul class="grid">
      {items.map(({ a, b, url }) => (
        <li><a href={url}><span class="t">{planTitle(a)} <span class="vs">vs</span> {planTitle(b)}</span><span class="muted small">{formatPrice(a.price)}/mo vs {formatPrice(b.price)}/mo</span></a></li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .page { padding-block: 24px 64px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font-size: clamp(36px, 5vw, 48px); }
  .lede { font-size: 18px; color: var(--muted); }
  .grid { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 12px; }
  .grid a { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink); text-decoration: none; }
  .grid a:hover { border-color: var(--ink); }
  .t { font-weight: 700; font-size: 17px; }
  .vs { color: var(--accent); }
</style>
