---
import Base from '../../layouts/Base.astro';
import CarrierLogo from '../../components/CarrierLogo.astro';
import PlanCard from '../../components/PlanCard.astro';
import { getData, type Carrier } from '../../lib/data';
import { formatNetworks, KIND_LONG } from '../../lib/model';
import { href } from '../../lib/site';

export async function getStaticPaths() {
  const { carriers } = await getData();
  return carriers.map((carrier) => ({ params: { slug: carrier.slug }, props: { carrier } }));
}
const { carrier: c } = Astro.props as { carrier: Carrier };
const { plans, carriers } = await getData();
const own = plans.filter((p) => p.carrier === c.slug);
// Other carriers on the same network, the usual next question.
const sameNetwork = carriers.filter((o) => o.slug !== c.slug && o.networks.some((n) => c.networks.includes(n)));
---
<Base title={`${c.name} plans`} description={`${c.name} phone plans compared: ${own.length} plans on the ${formatNetworks(c.networks)} network. ${c.summary}`} nav="carriers">
  <div class="band" style={`background:${c.color};color:${c.textOnColor}`}>
    <div class="wrap band-inner">
      <nav aria-label="Breadcrumb" class="crumbs"><a href={href('carriers/')}>Carriers</a></nav>
      <div class="title-row">
        <CarrierLogo carrier={c.lite} size={72} mode="white" />
        <div>
          <p class="kind">{KIND_LONG[c.kind]} · {formatNetworks(c.networks)} network</p>
          <h1 class="display">{c.name}</h1>
        </div>
      </div>
      <p class="summary">{c.summary}</p>
    </div>
  </div>
  <div class="wrap page">
    <section aria-labelledby="plans-h" class="sec">
      <h2 id="plans-h" class="display">{c.name} plans</h2>
      <ul class="card-grid">{own.map((p) => <PlanCard plan={p} />)}</ul>
      <p><a href={c.website} rel="noopener" target="_blank">Visit {c.name}<span class="sr-only"> (opens in a new tab)</span></a></p>
    </section>
    {sameNetwork.length > 0 && (
      <section aria-labelledby="net-h" class="sec">
        <h2 id="net-h" class="display">Also on the {formatNetworks(c.networks)} network</h2>
        <ul class="others">
          {sameNetwork.map((o) => (
            <li><a href={o.url} style={`background:${o.color};color:${o.textOnColor}`}><CarrierLogo carrier={o.lite} size={26} mode="white" />{o.name}</a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .band-inner { padding-block: 24px 32px; display: flex; flex-direction: column; gap: 16px; }
  .crumbs { font-size: 14px; }
  .crumbs a { color: inherit; }
  .title-row { display: flex; align-items: center; gap: 16px; }
  .kind { font-weight: 700; }
  h1 { font-size: clamp(36px, 5vw, 54px); }
  .summary { max-width: 680px; font-size: 18px; }
  .page { padding-block: 32px 64px; display: flex; flex-direction: column; gap: 40px; }
  .sec { display: flex; flex-direction: column; gap: 16px; }
  .sec h2 { font-size: 28px; }
  .others { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .others a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px 0 9px; border-radius: 999px; font-weight: 700; text-decoration: none; }
</style>
