---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { href } from '../lib/site';
import { NETWORKS } from '../lib/schema';
---
<Base title="How much could you save on your phone bill?" description="Enter what you pay now and see plans that fit how you use your phone, with what you'd pay over a year, fees included." nav="savings">
  <div class="wrap page">
    <header class="head">
      <h1 class="display">How much could you save?</h1>
      <p class="lede">Tell us what you pay now. We'll show plans that fit how you use your phone and what you'd save over a year, counting fees, not just the sticker price.</p>
    </header>

    <form id="savings-form" class="calc" aria-label="Savings calculator">
      <div class="field">
        <label for="bill">What you pay each month now</label>
        <div class="money"><span aria-hidden="true">$</span><input id="bill" name="bill" type="number" inputmode="decimal" min="0" step="1" value="160" required /></div>
        <p class="hint">Your whole bill for all lines, including taxes and fees. Check your last bill.</p>
      </div>
      <div class="field">
        <label for="lines">Lines on your bill</label>
        <select id="lines" name="lines">
          <option value="1">1 line</option><option value="2" selected>2 lines</option><option value="3">3 lines</option><option value="4">4 lines</option>
        </select>
      </div>
      <fieldset class="field">
        <legend>How much data do you use?</legend>
        <div class="seg">
          <label><input type="radio" name="data" value="light" /><span>Light</span></label>
          <label><input type="radio" name="data" value="average" checked /><span>Average</span></label>
          <label><input type="radio" name="data" value="heavy" /><span>Heavy</span></label>
        </div>
        <p class="hint"><a href={href('guides/how-much-data/')}>Not sure? Here's how to check.</a></p>
      </fieldset>
      <fieldset class="field">
        <legend>Do you need hotspot?</legend>
        <div class="seg">
          <label><input type="radio" name="hotspot" value="no" checked /><span>No</span></label>
          <label><input type="radio" name="hotspot" value="yes" /><span>Yes</span></label>
        </div>
      </fieldset>
      <div class="field">
        <label for="network">Network</label>
        <select id="network" name="network">
          <option value="any">Any network</option>
          {NETWORKS.map((n) => <option value={n}>{n} only</option>)}
        </select>
        <p class="hint">Pick one if it's the only network with good signal where you live. <a href={href('guides/coverage/')}>Check coverage</a>.</p>
      </div>
    </form>

    <section aria-labelledby="results-h" class="results">
      <div class="summary" id="summary" aria-live="polite"></div>
      <h2 id="results-h" class="display">Plans that fit, cheapest first</h2>
      <p class="small muted">First-year cost includes the plan price, listed monthly and one-time fees, and a full-price first month where AutoPay savings start later. Taxes are extra unless the plan says they're included, so your real savings may be a little lower.</p>
      <ol id="results" class="list"></ol>
      <noscript><p>The calculator needs JavaScript. You can still <a href={href('plans/')}>browse every plan</a>.</p></noscript>
      <AdSlot name="savings-results" />
    </section>

    <section aria-labelledby="more-h" class="more">
      <h2 id="more-h" class="display">More ways to save</h2>
      <ul class="tips">
        <li><strong>Check for discounts.</strong> Military, first responders, nurses, teachers, students, 55+ and some employers get money off. <a href={href('discounts/')}>See discounts</a>.</li>
        <li><strong>Pay upfront.</strong> Mint's lowest price needs 12 months paid at once. Visible and US Mobile also sell annual plans: check their sites for the yearly price.</li>
        <li><strong>Add lines.</strong> Many carriers charge much less per line with 3 or 4 lines. Try the finder with more lines.</li>
        <li><strong>Use AutoPay the right way.</strong> Some carriers only give the full AutoPay discount for a bank account. Each plan page explains how to qualify.</li>
        <li><strong>Skip the phone deal.</strong> "Free" phones usually tie you to a pricier plan for 36 months. <a href={href('guides/phone-deals/')}>Work out the real cost</a>.</li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import { initSavings } from '../scripts/savings';
  initSavings();
</script>

<style>
  .page { padding-block: 24px 64px; display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
  h1 { font-size: clamp(36px, 5vw, 50px); }
  .lede { font-size: 18px; color: var(--muted); }
  .calc { background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 20px 28px; }
  .field { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .field > label, legend { font-weight: 700; padding: 0; }
  legend { margin-bottom: 8px; }
  .hint { font-size: 13px; color: var(--muted); }
  .money { display: flex; align-items: center; gap: 6px; border: 2px solid var(--line); border-radius: 12px; padding: 0 12px; background: var(--surface); }
  .money:focus-within { border-color: var(--forest); }
  .money input { border: 0; outline: none; min-height: 44px; width: 100%; font-size: 20px; font-weight: 700; background: transparent; }
  select { min-height: 48px; padding: 0 12px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); font-size: 16px; }
  .seg { display: flex; gap: 6px; flex-wrap: wrap; }
  .seg label { position: relative; flex: 1 1 auto; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 2px solid var(--line); font-weight: 700; font-size: 14px; }
  .seg input:checked + span { background: var(--ink); border-color: var(--ink); color: #FFFFFF; }
  .seg input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .results { display: flex; flex-direction: column; gap: 14px; }
  .results h2, .more h2 { font-size: 28px; }
  .summary :global(.big-save) { background: var(--ink); color: #FFFFFF; border-radius: 24px; padding: 24px; display: flex; flex-wrap: wrap; gap: 8px 32px; align-items: baseline; }
  .summary :global(.big-save .display) { font-size: 44px; color: #FFFFFF; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .list :global(li) { background: var(--surface); border: 1px solid var(--line); border-left: 6px solid var(--brand); border-radius: 16px; padding: 16px 18px; display: grid; grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)) auto; gap: 8px 18px; align-items: center; }
  .list :global(.who a) { font-weight: 700; color: var(--ink); text-decoration: none; }
  .list :global(.who a:hover) { text-decoration: underline; }
  .list :global(.num) { display: flex; flex-direction: column; }
  .list :global(.num span:first-child) { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .list :global(.num strong) { font-size: 18px; }
  .list :global(.save-pos) { color: #146C43; }
  .list :global(.save-neg) { color: var(--muted); }
  .list :global(.sl-btn) { min-height: 44px; padding: 0 16px; font-size: 14px; }
  @media (max-width: 760px) { .list :global(li) { grid-template-columns: repeat(2, minmax(0, 1fr)); } .list :global(.who) { grid-column: 1 / -1; } .list :global(.sl-btn) { grid-column: 1 / -1; } }
  .tips { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; max-width: 820px; }
</style>
