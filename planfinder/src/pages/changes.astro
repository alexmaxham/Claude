---
import Base from '../layouts/Base.astro';
import { getData } from '../lib/data';
import { changes } from '../lib/extras';
import { href } from '../lib/site';
const { plans } = await getData();
const by = new Map(plans.map((p) => [p.slug, p]));
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const dates = [...new Set(changes.map((c) => c.date))];
---
<Base title="Price changes" description="What changed in our phone plan data and when: price changes, new plans, renamed plans and corrections." nav="guides">
  <div class="wrap page">
    <h1 class="display">Price changes</h1>
    <p class="lede">Every change to our plan data, newest first. Follow along with the <a href={href('changes.xml')}>RSS feed</a> in any feed reader.</p>
    {dates.map((d) => (
      <section aria-labelledby={`d-${d}`}>
        <h2 id={`d-${d}`}>{fmt(d)}</h2>
        <ul class="list">
          {changes.filter((c) => c.date === d).map((c) => (
            <li>
              <h3>{c.title}</h3>
              <p>{c.details}</p>
              {c.plans.length > 0 && <p class="links small">{c.plans.filter((s) => by.has(s)).map((s) => <a href={by.get(s)!.url}>{by.get(s)!.carrierInfo.name} {by.get(s)!.name}</a>)}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .page { padding-block: 24px 64px; display: flex; flex-direction: column; gap: 20px; max-width: 860px; }
  h1 { font-size: clamp(36px, 5vw, 48px); }
  .lede { font-size: 18px; color: var(--muted); }
  section { display: flex; flex-direction: column; gap: 12px; }
  h2 { font-family: var(--display); font-size: 24px; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .list li { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .list h3 { font-size: 18px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 14px; }
</style>
