---
// The device's product photo when it has one, otherwise the generated illustration.
import { Image } from 'astro:assets';
import type { Device } from '../lib/schema';
import { artHtml } from '../lib/art';
import { fullName } from '../lib/names';
import { photoFor, photoAlt } from '../lib/images';

interface Props {
  device: Device;
  /** Height in px of the box the art sits in. */
  height: number;
  shape?: boolean;
  class?: string;
  /** "eager" for the image at the top of a page. */
  loading?: 'lazy' | 'eager';
}
const { device, height, shape = true, class: className = '', loading = 'lazy' } = Astro.props;
const photo = photoFor(device);
const imgHeight = Math.round(height * 0.86);
---
{photo ? (
  <div class={`art has-photo ${className}`} style={`height:${height}px`}>
    {/* A blurred copy fills the box, so photos of any shape sit on matching color without cropping. */}
    <Image class="backdrop" src={photo} alt="" width={48} format="webp" loading={loading} />
    <Image
      class="photo"
      src={photo}
      alt={photoAlt(device)}
      height={imgHeight}
      densities={[1, 2]}
      format="webp"
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    />
  </div>
) : (
  <Fragment set:html={artHtml(device, height, fullName(device), shape, className)} />
)}
