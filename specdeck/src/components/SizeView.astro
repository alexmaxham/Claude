---
// Devices drawn to scale. The markup comes from lib/size.ts so the browser can redraw it when the devices change.
import { sizeViewHtml } from '../lib/size';
import type { Device } from '../lib/schema';

interface Props {
  devices: Device[];
}
const { devices } = Astro.props;
---
<div class="sizehost" data-size-view>
  {devices.length > 0 && <Fragment set:html={sizeViewHtml(devices)} />}
</div>

<style is:global>
  .sizehost:empty { display: none; }
  .sizeview { margin: 0; padding: 28px 24px 20px; border-radius: var(--shape-xl); background: var(--surface-low); }
  /* The drawing is at most 380px tall; labels share its width so each sits under its device. */
  .sizeview svg, .sizelabels { display: block; width: min(100%, calc(380px * var(--ratio))); margin-inline: auto; }
  .sizeview svg { height: auto; overflow: visible; }
  .sizeview image { filter: drop-shadow(0 6px 6px rgba(0,0,0,.22)); }
  .sizeview .screen { fill: var(--device-screen); }
  .sizeview .crease { stroke: rgba(255,255,255,.18); stroke-width: .4; }
  .sizelabels { display: grid; list-style: none; padding: 0; margin-top: 14px; padding-top: 12px; border-top: 2px solid var(--outline-var); text-align: center; font-size: 14px; }
  .sizelabels li { display: grid; align-content: start; gap: 2px; min-width: 0; }
  .sizelabels a { font-weight: 700; text-decoration: none; overflow-wrap: anywhere; line-height: 1.25; }
  .sizelabels a:hover { text-decoration: underline; }
  .sizelabels .num { color: var(--on-surface-var); font-size: 13px; }
  .sizeview figcaption, .size-none { margin: 16px 0 0; font-size: 13px; color: var(--on-surface-var); text-align: center; }
  .size-none { margin: 0; padding: 24px; border-radius: var(--shape-xl); background: var(--surface-low); }
  @media (max-width: 840px) {
    .sizeview { padding: 20px 12px 16px; border-radius: var(--shape-l); }
    .sizelabels { font-size: 12px; }
    .sizelabels .num { font-size: 11px; }
  }
</style>
