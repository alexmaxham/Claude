---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_NAME } from '../lib/site';
import { adsEnabled } from '../lib/ads';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Privacy' }];
---
<Base title="Privacy Policy" description={`How ${SITE_NAME} handles data, cookies and advertising.`}>
  <Breadcrumbs items={crumbs} />
  <article class="prose">
    <h1 class="headline">Privacy policy</h1>
    <p class="muted">Last updated October 20, 2026.</p>

    <h2 class="title">What this site stores</h2>
    <p>{SITE_NAME} has no visitor accounts and no sign-up. Two preferences are saved in your own browser (local storage) and never sent to us: the devices you picked to compare, and whether you chose light or dark mode. Clearing your browser's site data removes them.</p>

    <h2 class="title">Hosting</h2>
    <p>The site is hosted on Google Firebase Hosting. Like any web server, it receives your IP address and browser details when you load a page, and Google may keep these in server logs for security and reliability. See <a href="https://firebase.google.com/support/privacy" rel="noopener">Firebase's privacy information</a>.</p>

    <h2 class="title">Advertising</h2>
    {adsEnabled() ? (
      <Fragment>
    <p>{SITE_NAME} shows ads from Google AdSense. Third-party vendors, including Google, use cookies to serve ads based on your previous visits to this and other websites. Google's advertising cookies let it and its partners serve ads based on your visits to this site and other sites on the internet.</p>
    <p>You can turn off personalized advertising in <a href="https://adssettings.google.com" rel="noopener">Google's Ads Settings</a>, and opt out of some third-party vendors' cookies at <a href="https://www.aboutads.info/choices/" rel="noopener">aboutads.info</a>. Learn more about <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">how Google uses information from sites that use its services</a>.</p>
    <p>Visitors in the European Economic Area, the UK and Switzerland are asked for consent before personalized ads or advertising cookies are used, through Google's consent message.</p>
      </Fragment>
    ) : (
      <p>{SITE_NAME} doesn’t show ads or use advertising cookies at the moment. If that changes, this section will explain how ads work here and how to opt out.</p>
    )}

    <h2 class="title">Editors</h2>
    <p>The editing page is for the site's editors only. Editors sign in with a Google account through Firebase Authentication, and their email address is recorded with the changes they save.</p>

    <h2 class="title">Changes</h2>
    <p>If this policy changes, the date at the top of this page will change too.</p>
  </article>
</Base>

<style>
  .prose { max-width: 68ch; }
  .prose h2 { margin-top: 32px; }
  .prose p { margin: 12px 0 0; }
</style>
