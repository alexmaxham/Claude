---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { allDevices, brands, brandSlug } from '../../lib/devices';
import { breadcrumbLd } from '../../lib/seo';

const groups = brands(await allDevices());
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Brands' }];
---
<Base title="Phone and Tablet Brands" description={`Specs for phones and tablets from ${groups.map(([b]) => b).join(', ')}.`} jsonLd={[breadcrumbLd(crumbs, Astro.site!)]}>
  <Breadcrumbs items={crumbs} />
  <h1 class="headline">Brands</h1>
  <ul class="brands">
    {groups.map(([brand, list]) => (
      <li>
        <a href={`/brands/${brandSlug(brand)}/`}>
          <span class="title">{brand}</span>
          <span class="muted">{list.length} device{list.length === 1 ? '' : 's'}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .brands { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .brands a { display: flex; flex-direction: column; gap: 4px; padding: 20px; border-radius: var(--shape-l); background: var(--surface-c); text-decoration: none; transition: border-radius .4s var(--spring), background .2s; }
  .brands a:hover { border-radius: var(--shape-xl); background: var(--surface-high); }
  .brands .muted { font-size: 14px; }
</style>
